# CRAVE Food Delivery Platform — Server Configuration Template
# Copy this file to .env and configure your local or hosted environment.
# Never commit real credentials to version control.

# Server & Network
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (Local MongoDB or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/crave_food_delivery

# Authentication Security
JWT_SECRET=crave_super_secure_jwt_secret_token_evaluation_2026
JWT_EXPIRES_IN=7d

# Payment Gateway (Optional Live Razorpay Keys)
# If omitted, CRAVE automatically operates in authenticated Razorpay Sandbox simulation mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email SMTP Provider for Password Reset & Customer Support (Optional)
# If omitted, password reset tokens and URLs are safely output to the server terminal console in dev mode.
EMAIL_FROM=support@crave.com
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_SMTP_SECURE=false
