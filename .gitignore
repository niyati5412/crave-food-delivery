# ==========================
# CRAVE — Git Ignore Rules
# ==========================

# Node dependencies
node_modules/
client/node_modules/
server/node_modules/

# Build output
client/dist/
client/build/

# Environment variables — NEVER commit secrets
server/.env
client/.env
.env
.env.local
.env.production

# MongoDB local data directory
data/

# Scratch / temp files
scratch/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editor configs
.vscode/
.idea/
*.swp
*.swo

# Coverage
coverage/
